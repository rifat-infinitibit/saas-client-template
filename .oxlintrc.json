{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"plugins": ["react", "typescript", "jsx-a11y", "unicorn"],
	"categories": {
		"correctness": "off"
	},
	"options": {
		"typeAware": true
	},
	"env": {
		"builtin": true
	},
	"ignorePatterns": [
		".output/",
		".nitro/",
		".tanstack/",
		".claude/",
		"src/routeTree.gen.ts"
	],
	"rules": {
