# Copy to `.env`. Read by the server only; nothing here reaches the browser.

# The dev server and the built server both listen here.
PORT=3000

APP_MODE=saas

# `default` or `gt`, independent of the Mode; anything else wears `default`.
APP_BRAND=default

# Where a visitor with no Session is sent to be Launched from.
TENANT_PORTAL_URL=http://localhost:3202

# Where a SaaS sign-out revokes the Session.
PLATFORM_AUTH_URL=http://localhost:8000
