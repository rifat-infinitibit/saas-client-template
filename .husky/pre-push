branch=$(git rev-parse --abbrev-ref HEAD)
pattern='^(main|stage|dev)$|^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)/[a-z0-9-]+/[a-z0-9-]+$'

if ! echo "$branch" | grep -Eq "$pattern"; then
	echo "Branch '$branch' is not type/scope/slug, e.g. feat/notes/create-dialog." >&2
	exit 1
fi
