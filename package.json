{
	"name": "saas-client-template",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@12.8.1",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"start": "node --env-file-if-exists=.env .output/server/index.mjs",
		"test": "vitest run",
		"lint": "oxlint --deny-warnings",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"type:check": "pnpm i18n:compile && tsc",
		"i18n:compile": "paraglide-js compile --project ./project.inlang",
		"commit": "cz",
		"prepare": "husky && pnpm i18n:compile",
		"api:generate": "orval"
	},
	"config": {
		"commitizen": {
			"path": "cz-conventional-changelog"
		}
	},
	"lint-staged": {
		"*.{js,jsx,ts,tsx,mjs}": [
			"pnpm lint --fix",
			"oxfmt --no-error-on-unmatched-pattern"
		],
		"*.{css,md,json,yml,yaml}": "oxfmt --no-error-on-unmatched-pattern"
	},
	"dependencies": {
		"@fontsource-variable/dm-sans": "^5.3.0",
		"@infinitibit_gmbh/theme-default": "0.1.0-alpha.5",
		"@infinitibit_gmbh/ui": "0.1.0-alpha.5",
		"@tanstack/react-form": "^1.33.5",
		"@tanstack/react-pacer": "^0.24.0",
		"@tanstack/react-query": "^5.104.0",
		"@tanstack/react-router": "^1.170.41",
		"@tanstack/react-router-ssr-query": "^1.167.3",
		"@tanstack/react-start": "^1.168.60",
		"@tanstack/react-table": "^9.2.4",
		"axios": "^1.20.0",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"sonner": "^2.0.8",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@commitlint/cli": "^21.2.3",
		"@commitlint/config-conventional": "^21.2.3",
		"@faker-js/faker": "^10.6.0",
		"@inlang/paraglide-js": "^2.25.4",
		"@oxlint/plugins": "1.86.0",
		"@rolldown/plugin-babel": "^0.2.4",
		"@shadcn/lint": "^0.2.0",
		"@tailwindcss/vite": "^4.3.3",
		"@tanstack/devtools-vite": "^0.8.5",
		"@tanstack/eslint-plugin-router": "^1.162.0",
		"@testing-library/dom": "^10.4.2",
		"@testing-library/react": "^16.3.3",
		"@types/node": "^26.6.3",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.1",
		"babel-plugin-react-compiler": "^1.0.0",
		"commitizen": "^4.3.2",
		"cz-conventional-changelog": "^3.3.0",
		"husky": "^9.1.7",
		"jsdom": "^30.1.1",
		"lint-staged": "^17.6.0",
		"msw": "^3.0.0",
		"nitro": "3.0.260903-beta",
		"orval": "^8.38.0",
		"oxfmt": "0.71.0",
		"oxlint": "1.86.0",
		"oxlint-tsgolint": "7.0.2003",
		"semantic-release": "^25.0.9",
		"tailwindcss": "^4.3.3",
		"typescript": "^7.0.2",
		"vite": "^8.3.1",
		"vitest": "^5.0.2"
	},
	"commitlint": {
		"extends": [
			"@commitlint/config-conventional"
		]
	},
	"release": {
		"branches": [
			"main"
		],
		"plugins": [
			"@semantic-release/commit-analyzer",
			"@semantic-release/release-notes-generator",
			"@semantic-release/github"
		]
	},
	"msw": {
		"workerDirectory": [
			"public"
		]
	}
}
