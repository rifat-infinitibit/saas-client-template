# Copy to `.env`. Read by the server only; nothing here reaches the browser.

# The dev server and the built server both listen here.
PORT=3000

APP_MODE=standalone

# gt, which signs the user in. It must list this Application in its
# SSO_APP_RETURN_URIS, or sign-in is refused with SSO_APP_UNKNOWN.
GT_SERVER_URL=http://localhost:9000
