# Copy to `.env`. Read by the server and compose; nothing here reaches the browser.

# The dev server and the built server both listen here.
PORT=3000

# Where compose publishes the container on the host.
HOST_PORT=3000

APP_MODE=standalone

# `default` or `gt`, independent of the Mode; anything else wears `default`.
APP_BRAND=default

# gt, which signs the user in and fronts the Service with its Facade. It must
# list this Application in its SSO_APP_RETURN_URIS, or sign-in is refused with
# SSO_APP_UNKNOWN.
GT_SERVER_URL=http://localhost:9000
